# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# web-push subscriptions and visit stats (local/server file store)
/data/push-subscriptions.json
/data/analytics.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# heavy source exports (PDFs / raw deck renders)
/assets/source/